# Copy to .env. Generate a secret with: openssl rand -hex 32
JWT_SECRET=change-me

# Optional: host ports, change them if 8080, 5432, 8025 or 1025 are already used
# GATEWAY_PORT=8080
DB_PORT=5433
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# For test email verification with mailpit
# Optional: SMTP server used by the gateway to send emails (default: the mailpit container)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=Dashboard <noreply@dashboard.local>
# Credentials, for a real provider only (sent only over an encrypted connection)
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Email Adress verification, with Gmail (really sent the email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=Dashboard <victor.epitech.dasboard@gmail.com>
# Credentials, for a real provider only (sent only over an encrypted connection)
SMTP_USERNAME=victor.epitech.dashboard@gmail.com
SMTP_PASSWORD=app_password

# Optional: GitHub service and OAuth for private repository access
# Internal service URL used by the gateway in Docker Compose.
# GITHUB_URL=http://github:4000
# Create an OAuth App in GitHub. The callback URL must match exactly.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://localhost:8080/api/github/callback
# GITHUB_FRONTEND_URL=http://localhost:5173/
# Generate with: openssl rand -hex 32
# GITHUB_TOKEN_ENCRYPTION_KEY=