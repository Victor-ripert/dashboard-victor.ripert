# Interactive Brokers Credentials (used by Docker ib-gateway)
# Default 'edemo' / 'demouser' provides IB's built-in demo paper account.
# Replace with your own paper trading username and password if you have an account.
TWS_USERID=edemo
TWS_PASSWORD=demouser
TRADING_MODE=paper

# Trading Microservice Settings
# In Docker, IB_HOST is set to 'ib-gateway' (the container name).
# If running locally outside Docker, use '127.0.0.1'.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
IB_TIMEOUT=10.0

# Mock / Simulation Mode
# Set MOCK_MODE=true to force simulation even if IB Gateway is running.
# AUTO_FALLBACK_MOCK=true ensures API stays responsive while IB Gateway boots up.
MOCK_MODE=false
AUTO_FALLBACK_MOCK=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins for Dashboard Frontend
CORS_ORIGINS=*
